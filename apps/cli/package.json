{
  "name": "@iacviz/cli",
  "version": "0.1.0",
  "private": true,
  "description": "CLI tool for IaC Cloud Architecture Visualizer",
  "type": "module",
  "bin": {
    "iacviz": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
