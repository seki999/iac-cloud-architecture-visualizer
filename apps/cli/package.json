    "@iacviz/providers-aws": "workspace:*",
    "@iacviz/renderer-drawio": "workspace:*",
    "@iacviz/schemas": "workspace:*",
    "@iacviz/terraform-adapter": "workspace:*",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "tsx": "^4.19.2"
  }
