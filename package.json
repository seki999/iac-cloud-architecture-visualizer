{
  "name": "iac-cloud-architecture-visualizer",
  "version": "0.1.0",
  "private": true,
  "description": "Convert Terraform/OpenTofu state and plan JSON into editable, explainable cloud architecture diagrams (draw.io).",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint apps packages scripts *.js *.ts && prettier --check .",
    "format": "prettier --write .",
    "dev": "tsx apps/cli/src/index.ts",
    "iacviz": "node apps/cli/dist/index.js",
    "examples": "node scripts/generate-examples.mjs",
    "bench": "node scripts/benchmark.mjs",
    "verify:drawio": "node scripts/verify-drawio.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.15.0",
    "fast-xml-parser": "^4.5.0",
    "prettier": "^3.4.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.16.0",
    "vitest": "^2.1.8"
  }
}
